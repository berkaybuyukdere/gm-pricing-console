rules_version = '2';

// The pricing console never talks to Firestore from the browser: every read and
// write goes through the Cloud Function, which uses the Admin SDK and bypasses
// these rules. So the safe posture is a total client-side deny — it closes the
// door on anyone who finds the (public by design) web API key.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
